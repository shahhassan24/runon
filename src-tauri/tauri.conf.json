{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runon",
  "version": "1.0.0",
  "identifier": "com.shahhassan.runon",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Runon",
      "width": 1100, "height": 600, "minWidth": 1100, "minHeight": 600,
      "titleBarStyle": "Overlay", "hiddenTitle": true,
      "dragDropEnabled": false,
      "transparent": true,
      "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
    }],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Productivity",
    "copyright": "Built by Shah Hassan. Based on Freewrite by Farza Majeed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "../build/background.png",
        "windowSize": { "width": 720, "height": 420 },
        "appPosition": { "x": 360, "y": 200 },
        "applicationFolderPosition": { "x": 600, "y": 200 }
      }
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "sidebarImage": "../build/installerSidebar.bmp" }
    }
  }
}
